tavg_nc <- nc_open("/Users/aleynaturan/Desktop/a/hydroclimatology/assignment_3/data/tavg_1980_2020.nc")
lon      <- ncvar_get(pre_nc, "lon")
lat      <- ncvar_get(pre_nc, "lat")
time_raw <- ncvar_get(pre_nc, "time")
dates    <- as.Date("1900-01-01") + time_raw / 24
pre_data  <- ncvar_get(pre_nc,  "pre")
tavg_data <- ncvar_get(tavg_nc, "tavg")
nc_close(pre_nc)
nc_close(tavg_nc)
# replacinbg fill values with NA
pre_data[pre_data   == -9999] <- NA
tavg_data[tavg_data == -9999] <- NA
#  spatial avarage
# average over all lon/lat grid cells, keep time dimension
pre_mean  <- apply(pre_data,  3, mean, na.rm = TRUE)
tavg_mean <- apply(tavg_data, 3, mean, na.rm = TRUE)
# dataframe
df <- data.frame(
date  = dates,
year  = as.integer(format(dates, "%Y")),
month = as.integer(format(dates, "%m")),
pre   = pre_mean,
tavg  = tavg_mean
)
#  seasons
df$season <- ifelse(df$month %in% c(10,11,12,1,2,3), "summer", "winter")
# Oct-Dec belong to next year's summer
