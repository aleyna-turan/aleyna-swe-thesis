filter(season_year >= 1980 & season_year <= 2020) %>%
group_by(season_year, season) %>%
summarise(
pre_mean  = mean(pre,  na.rm = TRUE),
tavg_mean = mean(tavg, na.rm = TRUE),
.groups   = "drop"
)
# plotting
plot_trend <- function(data, season_name, variable, ylabel) {
d    <- data %>% filter(season == season_name)
mk   <- MannKendall(d[[variable]])
tau  <- round(mk$tau, 3)
pval <- round(mk$sl,  3)
# Build interpretation sentence
var_name <- ifelse(variable == "pre_mean", "precipitation", "temperature")
if (pval >= 0.05) {
interpretation <- paste0("No significant trend in ", var_name,
" during ", season_name,
" (tau = ", tau, ", p = ", pval, ").")
} else if (tau > 0) {
interpretation <- paste0("Significant increasing trend in ", var_name,
" during ", season_name,
" (tau = ", tau, ", p = ", pval, ").")
} else {
interpretation <- paste0("Significant decreasing trend in ", var_name,
" during ", season_name,
" (tau = ", tau, ", p = ", pval, ").")
}
ggplot(d, aes(x = season_year, y = .data[[variable]])) +
geom_point(color = "#4472C4", size = 2.5) +
geom_smooth(method = "lm", color = "#00008B", se = FALSE, linewidth = 1.2) +
labs(
title    = paste0("LON=-70.5 -69.75, LAT= -34.5 -33.0 ; ", season_name),
subtitle = paste0("tau = ", tau, "     2-sided pvalue = ", pval),
x        = NULL,
y        = ylabel,
caption  = interpretation
) +
scale_x_continuous(breaks = seq(1980, 2020, by = 10)) +
theme_classic(base_size = 13) +
theme(
plot.title    = element_text(face = "bold", size = 13),
plot.subtitle = element_text(size = 10, color = "gray40"),
axis.title.y  = element_text(size = 11),
plot.caption  = element_text(size = 10, color = "black",
hjust = 0, face = "italic",
margin = margin(t = 8)),
plot.margin   = margin(20, 25, 20, 25)
)
}
